
KEM_BLOB_TEST = tests/protocol/kem-blob-test

.PHONY: kem-blob-test

kem-blob-test: $(KEM_BLOB_TEST)
	./$(KEM_BLOB_TEST)

$(KEM_BLOB_TEST): tests/protocol/kem_blob_test.c libssh.a $(LIBCOMPAT)
	$(CC) $(CFLAGS) $(CPPFLAGS) -o $@ $< \
	    $(LDFLAGS) -lssh -lopenbsd-compat \
	    -lssh -lopenbsd-compat $(LIBS) $(CHANNELLIBS)

# Independent confirmation input and HMAC test

KEM_MAC_TEST = tests/protocol/kem-mac-test

.PHONY: kem-mac-test

kem-mac-test: $(KEM_MAC_TEST)
	./$(KEM_MAC_TEST)
	python3 tests/protocol/verify_kem_mac.py

$(KEM_MAC_TEST): tests/protocol/kem_mac_test.c libssh.a $(LIBCOMPAT)
	$(CC) $(CFLAGS) $(CPPFLAGS) -o $@ $< \
	    $(LDFLAGS) -lssh -lopenbsd-compat \
	    -lssh -lopenbsd-compat $(LIBS) $(CHANNELLIBS)

# Real ML-KEM-768 draft vector cross-check

KEM_REAL_TEST = tests/protocol/vector-work/kem-real-vector-check

.PHONY: kem-real-vector-check

kem-real-vector-check: $(KEM_REAL_TEST)
	./$(KEM_REAL_TEST)
	python3 tests/protocol/verify_real_vector.py

$(KEM_REAL_TEST): tests/protocol/check_real_vector.c libssh.a $(LIBCOMPAT)
	@mkdir -p tests/protocol/vector-work
	$(CC) $(CFLAGS) $(CPPFLAGS) -o $@ $< \
	    $(LDFLAGS) -lssh -lopenbsd-compat \
	    -lssh -lopenbsd-compat $(LIBS) $(CHANNELLIBS)
