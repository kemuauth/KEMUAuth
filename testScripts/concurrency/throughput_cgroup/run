#!/usr/bin/env bash
# Full-SSH concurrency throughput and server resource consumption
#
# Compares ML-KEM-768 KEMUAuth vs ML-DSA-65 signature authentication
# across different concurrency levels: throughput, CPU utilization, peak memory.
#
# Usage:
#   sudo bash testScripts/concurrency/throughput_cgroup/run
#   Or with overrides:
#   CONCURRENCY_LIST="1 8 16" RUNS=3 \
#   bash testScripts/concurrency/throughput_cgroup/run
#
# Environment variables:
#   CONCURRENCY_LIST    Concurrency levels (default: 1 8 16 32 64)
#   RUNS                Repetitions per scheme (default: 5)
#   WARMUP_SECONDS      Warm-up duration in seconds (default: 5)
#   MEASURE_SECONDS     Measurement duration in seconds (default: 30)
#   SERVER_CPUSET       Server CPU set (default: 0-1)
#   CLIENT_CPUSET       Client CPU set (default: 2-N)
#   PILOT_MODE          If 1, only run 1 16 64 (default: 0)

set -euo pipefail

ROOT_DIR="$(cd "$(dirname "$0")/../../.." && pwd)"
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
BACKENDS_DIR="$ROOT_DIR/testScripts/backends"

# ---- Load shared utilities ----
source "$BACKENDS_DIR/cgroup_utils.sh"

# ---- Must be set before sourcing sshd_test_harness.sh to avoid being overridden by harness defaults ----
TEST_PORT="${TEST_PORT:-42550}"

source "$BACKENDS_DIR/sshd_test_harness.sh"
source "$BACKENDS_DIR/cpu_isolation.sh"

# ---- Overridable parameters ----
CONCURRENCY_LIST="${CONCURRENCY_LIST:-1 8 16 32 64}"
PILOT_MODE="${PILOT_MODE:-0}"
RUNS="${RUNS:-5}"
WARMUP_SECONDS="${WARMUP_SECONDS:-5}"
MEASURE_SECONDS="${MEASURE_SECONDS:-30}"
COOLDOWN_SECONDS="${COOLDOWN_SECONDS:-10}"
TEST_USER="${TEST_USER:-$(id -un)}"
TEST_HOST="${TEST_HOST:-127.0.0.1}"
SERVER_CPUSET="${SERVER_CPUSET:-}"
CLIENT_CPUSET="${CLIENT_CPUSET:-}"
MAX_STARTUPS="${MAX_STARTUPS:-1024}"
KEEP_WORKDIR="${KEEP_WORKDIR:-1}"

# Experiment-specific work directory
WORK_DIR="${WORK_DIR:-$ROOT_DIR/testScripts/.work-concurrency-throughput}"
RESULT_DIR="$SCRIPT_DIR/results"

# Worker script
WORKER_SCRIPT="$SCRIPT_DIR/worker_client.sh"

# ---- Pilot mode ----
if [[ "$PILOT_MODE" == "1" ]]; then
  CONCURRENCY_LIST="1 16 64"
  RUNS=5
fi

# ---- Root check ----
if [[ "$(id -u)" -ne 0 ]]; then
  echo "[ERR] concurrency throughput experiment requires root for cgroup v2 + CPU affinity"
  echo "[HINT] run: sudo $0"
  exit 1
fi

# ---- Clean up leftovers (exact match to avoid killing the system sshd) ----
pkill -f "sshd.*-f.*${WORK_DIR}/sshd_" 2>/dev/null || true
# Clean up leftover cgroups
find /sys/fs/cgroup -maxdepth 1 -name 'ssh-concurrency-*' -type d 2>/dev/null | while read d; do
  rmdir "$d" 2>/dev/null || true
done
# Ensure port is released
sleep 1

# ---- Pre-checks ----
check_ssh_binaries || exit 1
check_cgroup_v2 || exit 1

# ---- CPU topology ----
ncpu="$(get_ncpu)"
echo "[INFO] system CPUs: $ncpu"

if [[ -z "$SERVER_CPUSET" ]]; then
  eval "$(auto_split_cpusets 2)"
fi
server_cores="$(count_cpuset_cpus "$SERVER_CPUSET")"
client_cores="$(count_cpuset_cpus "$CLIENT_CPUSET")"

overlap_check="$(cpuset_overlap "$SERVER_CPUSET" "$CLIENT_CPUSET")"
if [[ "$overlap_check" != "OK" ]]; then
  echo "[ERR] server and client cpusets overlap: $overlap_check"
  exit 1
fi

echo "[INFO] server_cpuset=$SERVER_CPUSET (${server_cores} cores)"
echo "[INFO] client_cpuset=$CLIENT_CPUSET (${client_cores} cores)"

# ---- Prepare directories ----
mkdir -p "$WORK_DIR" "$RESULT_DIR"

# ---- Generate keys ----
# Server host key: ML-DSA-65, matching the published experiment
HOST_KEY_ALGS="ssh-mldsa-65"
HOST_KEY_MD65="$(gen_host_key_mldsa65 "$WORK_DIR")"
ID_ED25519="$(gen_user_key_ed25519 "$WORK_DIR")"
ID_MD65="$(gen_user_key_mldsa65 "$WORK_DIR")"

KNOWN_HOSTS="$WORK_DIR/known_hosts"
gen_known_hosts "$WORK_DIR" "$HOST_KEY_MD65.pub" >/dev/null

AUTHORIZED_KEYS="$WORK_DIR/authorized_keys"
cat "$ID_MD65.pub" > "$AUTHORIZED_KEYS"

# KEM identity file (reuse files generated by step1)
KEM_ID_FILE="${KEM_ID_FILE:-$ROOT_DIR/testScripts/.work-kem/id_mlkem768}"
if [[ ! -f "$KEM_ID_FILE" ]]; then
  echo "[ERR] KEM identity file not found: $KEM_ID_FILE"
  echo "[HINT] run testScripts/backends/generate_kem_identity.sh first"
  exit 1
fi

# Extract KEM public key for authorized_kem_keys
KEM_PUBLIC_B64="$(awk 'BEGIN{IGNORECASE=1} $1~/^public$/{print $2; exit}' "$KEM_ID_FILE")"
AUTHORIZED_KEM_KEYS="$WORK_DIR/authorized_kem_keys"
printf 'ML-KEM-768 %s\n' "$KEM_PUBLIC_B64" > "$AUTHORIZED_KEM_KEYS"

# ---- Generate sshd config ----
SSHD_CFG_KEM="$WORK_DIR/sshd_kem.conf"
SSHD_CFG_MLDSA="$WORK_DIR/sshd_mldsa.conf"

write_sshd_config_kem_only "$SSHD_CFG_KEM" "$HOST_KEY_MD65" "$AUTHORIZED_KEM_KEYS"
write_sshd_config_sig_only "$SSHD_CFG_MLDSA" "$HOST_KEY_MD65" "$AUTHORIZED_KEYS"

SSHD_LOG_KEM="$WORK_DIR/sshd_kem.log"
SSHD_LOG_MLDSA="$WORK_DIR/sshd_mldsa.log"

# ---- Build client opts ----
KEM_CLIENT_OPTS="$(build_client_opts "$KNOWN_HOSTS" "$ID_ED25519" "$KEM_ID_FILE" "yes" "ML-KEM-768")"
SIG_CLIENT_OPTS="$(build_client_opts "$KNOWN_HOSTS" "$ID_MD65" "" "no" "")"

# ---- Result files ----
RAW_CSV="$RESULT_DIR/raw_runs.csv"
SUMMARY_CSV="$RESULT_DIR/summary.csv"
META_TXT="$RESULT_DIR/metadata.txt"

# Write CSV header
echo "run,mode,concurrency,attempted_count,success_count,failure_count,fail_conn_reset,fail_timeout,fail_other,throughput_conn_s,delta_cpu_usec,cpu_util_pct,cpu_per_conn_ms,peak_memory_bytes,peak_memory_mb,p95_latency_ms,duration_sec" > "$SUMMARY_CSV"
echo "run,mode,concurrency,conn_id,start_epoch,end_epoch,latency_ms,success,retcode,error_class" > "$RAW_CSV"

# ---- Environment metadata ----
cat > "$META_TXT" <<EOF
experiment: concurrent_server_throughput
timestamp: $(date -Iseconds)
hostname: $(hostname)
cpu_model: $(lscpu 2>/dev/null | grep 'Model name' | sed 's/Model name:\s*//' || echo NA)
cpu_cores: $ncpu
memory_gb: $(free -g 2>/dev/null | awk '/Mem:/{print $2}' || echo NA)
kernel: $(uname -r)
openssh_commit: $(git -C "$ROOT_DIR" rev-parse HEAD 2>/dev/null || echo NA)
server_cpuset: $SERVER_CPUSET
client_cpuset: $CLIENT_CPUSET
server_cores: $server_cores
warmup_seconds: $WARMUP_SECONDS
measure_seconds: $MEASURE_SECONDS
runs: $RUNS
concurrency_list: $CONCURRENCY_LIST
EOF

# ---- Main loop: alternate between KEM and ML-DSA ----
run_one_round() {
  local mode="$1"       # kem or mldsa
  local concurrency="$2"
  local run_id="$3"

  local sshd_cfg sshd_log auth_type_label
  local client_opts

  if [[ "$mode" == "kem" ]]; then
    sshd_cfg="$SSHD_CFG_KEM"
    sshd_log="$SSHD_LOG_KEM"
    client_opts="$KEM_CLIENT_OPTS"
    auth_type_label="KEMUAuth"
  else
    sshd_cfg="$SSHD_CFG_MLDSA"
    sshd_log="$SSHD_LOG_MLDSA"
    client_opts="$SIG_CLIENT_OPTS"
    auth_type_label="ML-DSA-65"
  fi

  echo ""
  echo "============================================"
  echo "[$(date +%H:%M:%S)] Round: $auth_type_label  concurrency=$concurrency  run=$run_id"
  echo "============================================"

  # ---- Create isolated cgroup ----
  local cg_name="ssh-concurrency-${mode}-n${concurrency}-r${run_id}"
  local cg_path
  echo "[DEBUG] creating cgroup: $cg_name"
  cg_path="$(create_cgroup "$cg_name")"
  echo "[DEBUG] cgroup created: $cg_path"

  # Reset cgroup (ensure clean starting state)
  echo "[DEBUG] resetting memory peak..."
  reset_memory_peak "$cg_path" 2>/dev/null || true
  echo "[DEBUG] memory peak reset done"

  # ---- Start sshd: write cgroup in sh -c + taskset CPU binding ----
  # sh -c gives a new PID, $$ expands to sh's own PID within sh
  # exec taskset replaces sh (same PID), then exec sshd (same PID)
  # bash child writes its own PID to cgroup, taskset binds CPU then exec sshd
  # $BASHPID = current bash process PID (bash 4.0+); $$ in a subshell refers to the parent PID, not applicable
  local sshd_pid
  bash -c '
    echo $BASHPID > "$1/cgroup.procs"
    exec taskset -c "$2" "$3" -D -f "$4" -E "$5"
  ' _ "$cg_path" "$SERVER_CPUSET" "$SSHD_BIN" "$sshd_cfg" "$sshd_log" &
  sshd_pid=$!

  sleep 0.5
  if ! kill -0 "$sshd_pid" 2>/dev/null; then
    echo "[ERR] sshd ($auth_type_label) failed to start"
    destroy_cgroup "$cg_path"
    return 1
  fi
  echo "[$(date +%H:%M:%S)] sshd PID=$sshd_pid cgroup=$(wc -l < $cg_path/cgroup.procs 2>/dev/null || echo 0)procs"
  # Use nc instead of ss (ss can be slow on some systems)
  local waited=0
  while [[ $waited -lt 20 ]]; do
    if nc -z "$TEST_HOST" "$TEST_PORT" 2>/dev/null; then
      break
    fi
    sleep 0.5
    waited=$((waited + 1))
  done
  if [[ $waited -ge 20 ]]; then
    echo "[WARN] sshd port $TEST_PORT not reachable after 10s, continuing anyway..."
  fi

  # ---- Warmup phase ----
  echo "[$(date +%H:%M:%S)] Warmup: ${WARMUP_SECONDS}s with ${concurrency} workers..."

  # Use lower concurrency for warmup (avoid interfering with the actual measurement)
  local warmup_pids=()
  local warmup_n=$(( concurrency < 4 ? concurrency : 4 ))
  for ((i=0; i<warmup_n; i++)); do
    bash "$WORKER_SCRIPT" \
      "$SSH_BIN" "$TEST_USER" "$TEST_HOST" "$TEST_PORT" \
      "$WARMUP_SECONDS" \
      "$client_opts" \
      "/dev/null" \
      "$CLIENT_CPUSET" \
      "$((i + 1))" &
    warmup_pids+=($!)
  done

  sleep "$WARMUP_SECONDS"

  # Kill warmup workers
  for pid in "${warmup_pids[@]}"; do
    kill "$pid" 2>/dev/null || true
    wait "$pid" 2>/dev/null || true
  done

  echo "[$(date +%H:%M:%S)] Warmup done."

  # ---- Read starting CPU counter ----
  local cpu_usage_start
  cpu_usage_start="$(read_cpu_usage_usec "$cg_path")"

  # ---- Start memory sampling (background) ----
  local mem_samples_file="$WORK_DIR/mem_samples_${mode}_n${concurrency}_r${run_id}.csv"
  echo "timestamp_epoch,memory_bytes,memory_mb" > "$mem_samples_file"

  local mem_sampler_pid
  (
    while true; do
      local mem_val now
      mem_val="$(read_memory_current "$cg_path")"
      now="$(date +%s.%N)"
      echo "$now,$mem_val,$(bytes_to_mb "$mem_val" 2>/dev/null || echo NA)" >> "$mem_samples_file"
      sleep 0.1
    done
  ) &
  mem_sampler_pid=$!

  # ---- Measurement phase ----
  echo "[$(date +%H:%M:%S)] Measure: ${MEASURE_SECONDS}s with ${concurrency} workers..."

  # Create unified start barrier
  local barrier_dir="$WORK_DIR/barrier_${mode}_n${concurrency}_r${run_id}"
  mkdir -p "$barrier_dir"

  local worker_pids=()
  local worker_result_files=()

  for ((i=0; i<concurrency; i++)); do
    local result_file="$WORK_DIR/worker_${mode}_n${concurrency}_r${run_id}_w${i}.csv"
    echo "conn_id,start_epoch,end_epoch,latency_ms,success,retcode,error_class" > "$result_file"
    worker_result_files+=("$result_file")

    bash "$WORKER_SCRIPT" \
      "$SSH_BIN" "$TEST_USER" "$TEST_HOST" "$TEST_PORT" \
      "$MEASURE_SECONDS" \
      "$client_opts" \
      "$result_file" \
      "$CLIENT_CPUSET" \
      "$i" \
      "$barrier_dir" &
    worker_pids+=($!)
  done

  # Wait for all workers to be ready (max 5 seconds)
  sleep 2
  local ready_count
  local ready_waited=0
  while [[ $ready_waited -lt 5 ]]; do
    ready_count=$(find "$barrier_dir" -name "ready_*" 2>/dev/null | wc -l)
    if [[ "$ready_count" -ge "$concurrency" ]]; then
      break
    fi
    sleep 0.5
    ready_waited=$((ready_waited + 1))
  done
  echo "[$(date +%H:%M:%S)] Workers ready: $ready_count / $concurrency"

  # Release barrier
  local measure_start_epoch
  measure_start_epoch="$(date +%s.%N)"
  echo "$measure_start_epoch" > "$barrier_dir/go"

  echo "[$(date +%H:%M:%S)] Barrier released at epoch=$measure_start_epoch"

  # Wait for measurement window to end
  sleep "$MEASURE_SECONDS"
  local measure_end_epoch
  measure_end_epoch="$(date +%s.%N)"

  # Send stop signal to all workers
  touch "$barrier_dir/stop"

  # Wait for all workers to exit
  for pid in "${worker_pids[@]}"; do
    wait "$pid" 2>/dev/null || true
  done

  echo "[$(date +%H:%M:%S)] All workers finished."

  # ---- Read ending CPU counter ----
  local cpu_usage_end
  cpu_usage_end="$(read_cpu_usage_usec "$cg_path")"

  # ---- Stop memory sampling ----
  kill "$mem_sampler_pid" 2>/dev/null || true
  wait "$mem_sampler_pid" 2>/dev/null || true

  # ---- Read memory.peak ----
  local peak_memory
  peak_memory="$(read_memory_peak "$cg_path")"

  # ---- Compute metrics ----
  local delta_cpu_usec="NA"
  if [[ "$cpu_usage_start" != "NA" && "$cpu_usage_end" != "NA" ]] && \
     [[ "$cpu_usage_start" =~ ^[0-9]+$ ]] && [[ "$cpu_usage_end" =~ ^[0-9]+$ ]]; then
    delta_cpu_usec=$((cpu_usage_end - cpu_usage_start))
  fi

  # Aggregate all worker results, only count connections within measurement window
  local total_success=0
  local total_failure=0
  local fail_conn_reset=0    # connection_error (retcode 255)
  local fail_timeout=0       # timeout (retcode 124)
  local fail_auth=0          # auth failure (retcode != 0/124/255)
  local fail_other=0         # other
  local latencies_file="$WORK_DIR/latencies_${mode}_n${concurrency}_r${run_id}.txt"
  : > "$latencies_file"

  for rf in "${worker_result_files[@]}"; do
    if [[ -f "$rf" ]]; then
      while IFS=',' read -r conn_id start_ep end_ep lat_ms success retcode err_class; do
        [[ "$conn_id" == "conn_id" ]] && continue  # skip header
        [[ -z "$start_ep" ]] && continue

        # No time window filtering needed — workers only run during measurement
        if [[ "$success" == "1" ]]; then
          total_success=$((total_success + 1))
          echo "$lat_ms" >> "$latencies_file"
          echo "${run_id},${mode},${concurrency},${mode}_n${concurrency}_${conn_id},${start_ep},${end_ep},${lat_ms},${success},${retcode},${err_class}" >> "$RAW_CSV"
        else
          total_failure=$((total_failure + 1))
          case "$retcode" in
            255) fail_conn_reset=$((fail_conn_reset + 1)) ;;
            124) fail_timeout=$((fail_timeout + 1)) ;;
            0) ;;  # shouldn't happen
            *)   fail_other=$((fail_other + 1)) ;;
          esac
          echo "${run_id},${mode},${concurrency},${mode}_n${concurrency}_${conn_id},${start_ep},${end_ep},${lat_ms},${success},${retcode},${err_class}" >> "$RAW_CSV"
        fi
      done < "$rf"
    fi
  done

  # Compute throughput
  local throughput="NA"
  if [[ "$total_success" -gt 0 ]]; then
    throughput="$(awk "BEGIN {printf \"%.2f\", $total_success / $MEASURE_SECONDS}")"
  fi

  # Compute CPU utilization
  local cpu_util="NA"
  if [[ "$delta_cpu_usec" != "NA" ]]; then
    cpu_util="$(calc_cpu_util "$delta_cpu_usec" "$MEASURE_SECONDS" "$server_cores")"
  fi

  # Compute CPU per connection
  local cpu_per_conn="NA"
  if [[ "$delta_cpu_usec" != "NA" && "$total_success" -gt 0 ]]; then
    cpu_per_conn="$(calc_cpu_per_conn "$delta_cpu_usec" "$total_success")"
  fi

  # Compute p95 latency
  local p95_latency="NA"
  if [[ -s "$latencies_file" ]]; then
    p95_latency="$(sort -n "$latencies_file" | python3 -c "
import sys
vals = [float(l.strip()) for l in sys.stdin if l.strip()]
if vals:
    idx = int(len(vals) * 0.95)
    print(f'{sorted(vals)[min(idx, len(vals)-1)]:.2f}')
else:
    print('NA')
" 2>/dev/null)"
  fi

  # Peak memory (MB)
  local peak_memory_mb="NA"
  if [[ "$peak_memory" != "NA" && "$peak_memory" =~ ^[0-9]+$ ]]; then
    peak_memory_mb="$(bytes_to_mb "$peak_memory")"
  fi

  # Failure rate
  local total_attempts=$((total_success + total_failure))
  local failure_rate="NA"
  if [[ "$total_attempts" -gt 0 ]]; then
    failure_rate="$(python3 -c "print(f'{int($total_failure)/int($total_attempts)*100:.2f}')" 2>/dev/null)"
  fi

  # ---- Write summary ----
  echo "${run_id},${mode},${concurrency},${total_attempts},${total_success},${total_failure},${fail_conn_reset},${fail_timeout},${fail_other},${throughput},${delta_cpu_usec},${cpu_util},${cpu_per_conn},${peak_memory},${peak_memory_mb},${p95_latency},${MEASURE_SECONDS}" >> "$SUMMARY_CSV"

  # ---- Output this round's results ----
  local total_attempts=$((total_success + total_failure))
  echo ""
  echo "  Results: $auth_type_label N=$concurrency run=$run_id"
  echo "  ─────────────────────────────────────────────"
  echo "  Attempted:         $total_attempts"
  echo "  Successful:        $total_success"
  echo "  Failed:            $total_failure (${failure_rate}%)"
  if [[ "$total_failure" -gt 0 ]]; then
    echo "    - conn_reset:    $fail_conn_reset"
    echo "    - timeout:       $fail_timeout"
    echo "    - other:         $fail_other"
  fi
  echo "  Throughput:        ${throughput} conn/s"
  echo "  CPU Δusage_usec:   $delta_cpu_usec"
  echo "  CPU Utilization:   ${cpu_util}%"
  echo "  CPU/conn:          ${cpu_per_conn} ms"
  echo "  Peak Memory:       ${peak_memory_mb} MB"
  echo "  p95 Latency:       ${p95_latency} ms"

  # ---- Cleanup ----
  # Stop sshd
  if [[ -n "$sshd_pid" ]] && kill -0 "$sshd_pid" 2>/dev/null; then
    kill "$sshd_pid" 2>/dev/null || true
    wait "$sshd_pid" 2>/dev/null || true
  fi

  # Destroy cgroup
  sleep 1
  destroy_cgroup "$cg_path"

  # Clean up barrier directory
  rm -rf "$barrier_dir"

  # Cooldown
  echo "[$(date +%H:%M:%S)] Cooldown: ${COOLDOWN_SECONDS}s..."
  sleep "$COOLDOWN_SECONDS"
}

# ---- Main loop: alternating runs ----
echo ""
echo "================================================"
echo "  Concurrent Server Throughput + cgroup Resources"
echo "  Concurrency: $CONCURRENCY_LIST"
echo "  Runs per mode: $RUNS"
echo "  Warmup: ${WARMUP_SECONDS}s  Measure: ${MEASURE_SECONDS}s"
echo "================================================"
echo ""

for N in $CONCURRENCY_LIST; do
  for ((r=1; r<=RUNS; r++)); do
    # Alternate: KEM first, then ML-DSA
    run_one_round "kem" "$N" "$r"   || echo "[WARN] kem N=$N run=$r had issues, continuing..."
    run_one_round "mldsa" "$N" "$r" || echo "[WARN] mldsa N=$N run=$r had issues, continuing..."
  done
done

echo ""
echo "================================================"
echo "  Concurrent server throughput experiment complete!"
echo "  Summary: $SUMMARY_CSV"
echo "  Raw data: $RAW_CSV"
echo "  Metadata: $META_TXT"
echo "================================================"

# ---- Generate summary report ----
if command -v python3 >/dev/null 2>&1; then
  python3 "$SCRIPT_DIR/analyze.py" "$SUMMARY_CSV" "$RESULT_DIR/report.md" 2>/dev/null || {
    echo "[WARN] analyze.py failed; you can run it manually later"
  }
  if [[ -f "$RESULT_DIR/report.md" ]]; then
    echo ""
    echo "=== Report ==="
    cat "$RESULT_DIR/report.md"
  fi
fi
