#!/usr/bin/env bash
# Top-level entry point for the server-side concurrency evaluation
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "$0")/../.." && pwd)"
THRU_DIR="$ROOT_DIR/testScripts/concurrency/throughput_cgroup"
PEND_DIR="$ROOT_DIR/testScripts/concurrency/pending_memory"

usage() {
    cat <<'EOF'
Usage:
  bash testScripts/concurrency/run [--mode throughput|pending|all]

Options:
  --mode throughput   Run throughput + cgroup experiment only
  --mode pending      Run pending memory experiment only
  --mode all          Run both (default)
EOF
}

MODE="${1:-all}"
case "$MODE" in
    --mode)
        MODE="${2:-}"
        ;;
    -h|--help)
        usage
        exit 0
        ;;
esac

case "$MODE" in
    throughput|pending|all)
        ;;
    *)
        echo "[ERR] unsupported mode: ${MODE:-<empty>}"
        usage
        exit 1
        ;;
esac

if [[ "$MODE" == "throughput" || "$MODE" == "all" ]]; then
    echo "[STEP] concurrency evaluation: server throughput"
    sudo bash "$THRU_DIR/run"
fi

if [[ "$MODE" == "pending" || "$MODE" == "all" ]]; then
    echo "[STEP] concurrency evaluation: pending-state memory"
    sudo bash "$PEND_DIR/run"
fi

echo "[OK] concurrency evaluation completed"
