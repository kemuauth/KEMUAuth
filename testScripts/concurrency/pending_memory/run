#!/usr/bin/env bash
# Pending-authentication-state memory experiment
#
# Artificially delays the client after receiving a KEM challenge before sending
# the response, so the server stably holds many pending challenges.
# Measures peak memory and fits M(P)=α+βP.
#
# Prerequisites:
#   1. Build this paper branch with KEM_TEST_INSTRUMENTATION enabled.
#   2. Root access (for cgroup v2)
#
# Usage:
#   sudo bash testScripts/concurrency/pending_memory/run

set -euo pipefail

ROOT_DIR="$(cd "$(dirname "$0")/../../.." && pwd)"
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
BACKENDS_DIR="$ROOT_DIR/testScripts/backends"

source "$BACKENDS_DIR/cgroup_utils.sh"

# ---- Must be set before sourcing sshd_test_harness.sh ----
TEST_PORT="${TEST_PORT:-42560}"
LOG_LEVEL="${LOG_LEVEL:-DEBUG1}"

source "$BACKENDS_DIR/sshd_test_harness.sh"
source "$BACKENDS_DIR/cpu_isolation.sh"

# ---- Overridable parameters ----
TARGET_CONCURRENCY="${TARGET_CONCURRENCY:-0 16 32 64 128 256}"
RUNS="${RUNS:-5}"
RESPONSE_DELAY_MS="${RESPONSE_DELAY_MS:-10000}"   # Client pauses for 10 seconds after receiving challenge
HOLD_WINDOW_SEC="${HOLD_WINDOW_SEC:-15}"           # Hold window (should be > RESPONSE_DELAY_MS/1000)
SAMPLE_INTERVAL_SEC="${SAMPLE_INTERVAL_SEC:-0.1}"  # Memory sampling interval
POST_HOLD_WAIT_SEC="${POST_HOLD_WAIT_SEC:-10}"     # Post-disconnect observation time
CLIENT_CONNECT_TIMEOUT="${CLIENT_CONNECT_TIMEOUT:-45}"
TEST_USER="${TEST_USER:-$(id -un)}"
TEST_HOST="${TEST_HOST:-127.0.0.1}"
MAX_STARTUPS="${MAX_STARTUPS:-1024}"
KEEP_WORKDIR="${KEEP_WORKDIR:-1}"

# Ensure timeout > client delay + connection overhead
_min_timeout=$((RESPONSE_DELAY_MS / 1000 + 15))
if [[ "$CLIENT_CONNECT_TIMEOUT" -lt "$_min_timeout" ]]; then
  CLIENT_CONNECT_TIMEOUT="$_min_timeout"
fi

WORK_DIR="${WORK_DIR:-$ROOT_DIR/testScripts/.work-pending-memory}"
RESULT_DIR="$SCRIPT_DIR/results"

# ---- Root check ----
if [[ "$(id -u)" -ne 0 ]]; then
  echo "[ERR] pending-memory experiment requires root for cgroup v2"
  echo "[HINT] run: sudo $0"
  exit 1
fi

# ---- Infrastructure tuning (avoid TCP backlog / port exhaustion) ----
sysctl -w net.core.somaxconn=4096 2>/dev/null || true
sysctl -w net.ipv4.ip_local_port_range="1024 65535" 2>/dev/null || true
sysctl -w net.ipv4.tcp_tw_reuse=1 2>/dev/null || true
ulimit -n 65536 2>/dev/null || true

# ---- Clean up leftovers ----
# Kill any leftover sshd processes from previous runs
pkill -f "sshd.*-f.*${WORK_DIR}/sshd_" 2>/dev/null || true
sleep 1
# Clean up leftover cgroups (clear processes first, then remove directory)
find /sys/fs/cgroup -maxdepth 1 -name 'ssh-pending-memory-*' -type d 2>/dev/null | while read d; do
  echo "" > "$d/cgroup.procs" 2>/dev/null || true
  sleep 0.1
  rmdir "$d" 2>/dev/null || true
done
sleep 1

# ---- Pre-checks ----
check_ssh_binaries || exit 1
check_cgroup_v2 || exit 1

# ---- Verify KEM_TEST_INSTRUMENTATION is present in the built binaries ----
server_marker_found=0
for bin in "$SSHD_BIN" "$SSHD_AUTH_BIN" "$SSHD_SESSION_BIN"; do
  if [[ -f "$bin" ]] && grep -a -q 'KEM_PENDING_INC' "$bin" 2>/dev/null; then
    server_marker_found=1
    break
  fi
done

if [[ "$server_marker_found" -ne 1 ]]; then
  echo "[ERR] KEM_TEST_INSTRUMENTATION server markers are not present in the built binaries."
  echo "[HINT] Rebuild OpenSSH with KEM_TEST_INSTRUMENTATION enabled before running this experiment."
  exit 1
fi

if ! grep -a -q 'BASELINE_PAUSE_INC' "$SSH_BIN" 2>/dev/null ||
   ! grep -a -q 'KEMUAUTH_RESPONSE_DELAY_MS' "$SSH_BIN" 2>/dev/null; then
  echo "[ERR] KEM_TEST_INSTRUMENTATION client markers are not present in $SSH_BIN."
  echo "[HINT] Rebuild OpenSSH with KEM_TEST_INSTRUMENTATION enabled before running this experiment."
  exit 1
fi

echo "[INFO] KEM_TEST_INSTRUMENTATION markers verified"

# ---- Prepare directories ----
mkdir -p "$WORK_DIR" "$RESULT_DIR"

# ---- Generate keys ----
HOST_KEY_ALGS="ssh-mldsa-65"
HOST_KEY_MD65="$(gen_host_key_mldsa65 "$WORK_DIR")"
ID_ED25519="$(gen_user_key_ed25519 "$WORK_DIR")"

KNOWN_HOSTS="$WORK_DIR/known_hosts"
gen_known_hosts "$WORK_DIR" "$HOST_KEY_MD65.pub" >/dev/null

# KEM identity
KEM_ID_FILE="${KEM_ID_FILE:-$ROOT_DIR/testScripts/.work-kem/id_mlkem768}"
if [[ ! -f "$KEM_ID_FILE" ]]; then
  echo "[ERR] KEM identity not found: $KEM_ID_FILE"
  exit 1
fi
KEM_PUBLIC_B64="$(awk 'BEGIN{IGNORECASE=1} $1~/^public$/{print $2; exit}' "$KEM_ID_FILE")"
AUTHORIZED_KEM_KEYS="$WORK_DIR/authorized_kem_keys"
printf 'ML-KEM-768 %s\n' "$KEM_PUBLIC_B64" > "$AUTHORIZED_KEM_KEYS"

# ---- Baseline key (ML-DSA-65) ----
ID_MD65="$(gen_user_key_mldsa65 "$WORK_DIR")"
AUTHORIZED_KEYS="$WORK_DIR/authorized_keys"
cat "$ID_MD65.pub" > "$AUTHORIZED_KEYS"

# ---- sshd config ----
SSHD_CFG_KEM="$WORK_DIR/sshd_kem.conf"
SSHD_CFG_BASELINE="$WORK_DIR/sshd_baseline.conf"
SSHD_LOG_KEM="$WORK_DIR/sshd_kem.log"
SSHD_LOG_BASELINE="$WORK_DIR/sshd_baseline.log"

write_sshd_config_kem_only "$SSHD_CFG_KEM" "$HOST_KEY_MD65" "$AUTHORIZED_KEM_KEYS"
write_sshd_config_sig_only "$SSHD_CFG_BASELINE" "$HOST_KEY_MD65" "$AUTHORIZED_KEYS"

# ---- Client opts ----
KEM_CLIENT_OPTS="$(build_client_opts "$KNOWN_HOSTS" "$ID_ED25519" "$KEM_ID_FILE" "yes" "ML-KEM-768")"

# Baseline opts (ML-DSA-65 signature authentication)
BASELINE_CLIENT_OPTS="$(build_client_opts "$KNOWN_HOSTS" "$ID_MD65" "" "no" "")"

# ---- Result files ----
SUMMARY_CSV="$RESULT_DIR/summary.csv"
META_TXT="$RESULT_DIR/metadata.txt"

echo "target_concurrency,mode,run,peak_memory_bytes,peak_memory_mb,mem_samples_file,pending_estimate,pids_peak,residual_memory_mb,final_pending,cleanup_ok" > "$SUMMARY_CSV"

cat > "$META_TXT" <<EOF
experiment: pending_authentication_state_memory
timestamp: $(date -Iseconds)
hostname: $(hostname)
cpu_model: $(lscpu 2>/dev/null | grep 'Model name' | sed 's/Model name:\s*//' || echo NA)
kernel: $(uname -r)
openssh_commit: $(git -C "$ROOT_DIR" rev-parse HEAD 2>/dev/null || echo NA)
response_delay_ms: $RESPONSE_DELAY_MS
hold_window_sec: $HOLD_WINDOW_SEC
sample_interval_sec: $SAMPLE_INTERVAL_SEC
runs: $RUNS
target_concurrency: $TARGET_CONCURRENCY
EOF

# ---- Read real-time pending count from sshd log ----
# ssh-kem.c writes directly to stderr via write() (unbuffered, real-time visible)
# Log lines: "KEM_PENDING_INC\n" or "KEM_PENDING_DEC\n"
get_pending_from_log() {
  local log_file="$1"
  if [[ ! -f "$log_file" ]]; then
    echo "0"
    return
  fi
  local inc_count dec_count
  inc_count="$(grep -c 'KEM_PENDING_INC' "$log_file" 2>/dev/null || true)"
  dec_count="$(grep -c 'KEM_PENDING_DEC' "$log_file" 2>/dev/null || true)"
  inc_count="${inc_count:-0}"
  dec_count="${dec_count:-0}"
  echo $((inc_count - dec_count))
}

# Peak pending: compute running maximum of INC-DEC line by line
get_peak_pending_from_log() {
  local log_file="$1"
  if [[ ! -f "$log_file" ]]; then
    echo "0"
    return
  fi
  awk '
    /KEM_PENDING_INC/  { cur++; if (cur > peak) peak = cur }
    /KEM_PENDING_DEC/  { cur-- }
    END { print (peak > 0 ? peak : 0) }
  ' "$log_file" 2>/dev/null || echo "0"
}

# Count baseline concurrent pauses from client logs
# BASELINE_PAUSE_INC/DEC output by ssh client via fprintf(stderr)
# Since all clients start synchronously via barrier + same pause duration, total INC count = actual concurrency
get_baseline_peak_from_client_logs() {
  local client_logs_dir="$1"
  if [[ ! -d "$client_logs_dir" ]]; then
    echo "0"
    return
  fi
  # Directly count total INC (barrier ensures simultaneous pause, peak = total INC)
  grep -c "BASELINE_PAUSE_INC" "$client_logs_dir"/*.log 2>/dev/null \
    | awk -F: '{sum += $2} END {print sum+0}'
}



# ---- Estimate pending count (pgrep fallback, only used when no log available) ----
estimate_pending_count() {
  local sshd_pid="$1"
  local count=0
  # Count sshd child processes (privsep children)
  for child_pid in $(pgrep -P "$sshd_pid" 2>/dev/null || true); do
    # Check if child process is still running
    if kill -0 "$child_pid" 2>/dev/null; then
      count=$((count + 1))
    fi
    # Recursively
    for grandchild in $(pgrep -P "$child_pid" 2>/dev/null || true); do
      if kill -0 "$grandchild" 2>/dev/null; then
        count=$((count + 1))
      fi
    done
  done
  echo "$count"
}

# ---- Single round run ----
run_one_round() {
  local mode="$1"        # kem or baseline
  local target_n="$2"    # Target concurrent connections
  local run_id="$3"

  local sshd_cfg sshd_log label client_opts remote_cmd
  if [[ "$mode" == "kem" ]]; then
    sshd_cfg="$SSHD_CFG_KEM"
    sshd_log="$SSHD_LOG_KEM"
    label="KEMUAuth"
    client_opts="$KEM_CLIENT_OPTS"
    export KEMUAUTH_RESPONSE_DELAY_MS="$RESPONSE_DELAY_MS"
    remote_cmd="true"
  else
    sshd_cfg="$SSHD_CFG_BASELINE"
    sshd_log="$SSHD_LOG_BASELINE"
    label="Baseline-MLDSA"
    client_opts="$BASELINE_CLIENT_OPTS"
    unset KEMUAUTH_RESPONSE_DELAY_MS
    # Baseline pauses after receiving PK_OK, before sending signature (aligned with KEM pending phase)
    export SIGAUTH_RESPONSE_DELAY_MS="$RESPONSE_DELAY_MS"
    remote_cmd="true"
  fi

  echo ""
  echo "============================================"
  echo "[$(date +%H:%M:%S)] P=$target_n  $label  run=$run_id"
  echo "============================================"

  # ---- Create cgroup ----
  local cg_name="ssh-pending-memory-${mode}-p${target_n}-r${run_id}"
  local cg_path
  cg_path="$(create_cgroup "$cg_name")"
  # Reset memory.peak (avoid stale values when reusing old cgroup)
  echo "0" > "$cg_path/memory.peak" 2>/dev/null || true

  # ---- Truncate log (avoid cross-run INC/DEC accumulation) ----
  : > "$sshd_log"

  # ---- Start sshd (start inside cgroup to ensure complete memory accounting) ----
  # Use bash -c + $BASHPID: first write own PID to cgroup.procs, then exec sshd
  # sshd and all forked child processes automatically inherit cgroup, no watcher polling needed
  local sshd_pid
  bash -c '
    echo $BASHPID >> "$1/cgroup.procs"
    exec "$2" -D -f "$3" -E "$4"
  ' _ "$cg_path" "$SSHD_BIN" "$sshd_cfg" "$sshd_log" &
  sshd_pid=$!
  sleep 1

  if ! kill -0 "$sshd_pid" 2>/dev/null; then
    echo "[ERR] sshd failed to start"
    destroy_cgroup "$cg_path"
    return 1
  fi

  # Wait for sshd to be ready
  sleep 1

  # ---- P=0 special case (idle baseline) ----
  if [[ "$target_n" -eq 0 ]]; then
    echo "[$(date +%H:%M:%S)] P=0: measuring idle baseline for ${HOLD_WINDOW_SEC}s"

    local mem_samples_file="$WORK_DIR/mem_${mode}_p0_r${run_id}.csv"
    echo "timestamp_epoch,memory_bytes,memory_mb" > "$mem_samples_file"

    local mem_sampler_pid
    (
      local start_t="$(date +%s)"
      while true; do
        local now_t="$(date +%s)"
        local elapsed=$((now_t - start_t))
        if [[ $elapsed -ge $HOLD_WINDOW_SEC ]]; then break; fi
        local mem_val
        mem_val="$(read_memory_current "$cg_path")"
        echo "$(date +%s.%N),$mem_val,$(bytes_to_mb "$mem_val")" >> "$mem_samples_file"
        sleep "$SAMPLE_INTERVAL_SEC"
      done
    ) &
    mem_sampler_pid=$!

    sleep "$HOLD_WINDOW_SEC"
    wait "$mem_sampler_pid" 2>/dev/null || true

    local peak_mem peak_mem_mb
    peak_mem="$(read_memory_peak "$cg_path")"
    peak_mem_mb="$(bytes_to_mb "$peak_mem")"

    echo "${target_n},${mode},${run_id},${peak_mem},${peak_mem_mb},${mem_samples_file},0,0,NA,0,YES" >> "$SUMMARY_CSV"

    echo "[$(date +%H:%M:%S)] P=0 result: peak_mem=${peak_mem_mb} MB"

    kill "$sshd_pid" 2>/dev/null || true
    wait "$sshd_pid" 2>/dev/null || true
    destroy_cgroup "$cg_path"
    return 0
  fi

  # ---- Launch clients (barrier sync + batched launch) ----
  echo "[$(date +%H:%M:%S)] Launching $target_n clients with ${RESPONSE_DELAY_MS}ms delay..."

  local client_pids=()
  local client_logs_dir="$WORK_DIR/client_logs_${mode}_p${target_n}_r${run_id}"
  mkdir -p "$client_logs_dir"

  # Barrier file: release all at once after all clients are launched
  local barrier_file="$WORK_DIR/barrier_${mode}_p${target_n}_r${run_id}"
  touch "$barrier_file"

  # Launch clients in batches (avoid burst impact), wait on barrier within each batch
  local batch_size=16
  local launched=0

  while [[ $launched -lt $target_n ]]; do
    local batch_end=$((launched + batch_size))
    if [[ $batch_end -gt $target_n ]]; then
      batch_end=$target_n
    fi

    for ((i=launched; i<batch_end; i++)); do
      local client_log="$client_logs_dir/client_${i}.log"
      (
        # Wait for barrier release (all clients start connecting simultaneously)
        while [[ -f "$barrier_file" ]]; do sleep 0.02; done
        export KEMUAUTH_RESPONSE_DELAY_MS="$RESPONSE_DELAY_MS"
        # shellcheck disable=SC2086
        timeout "$CLIENT_CONNECT_TIMEOUT" "$SSH_BIN" \
          $client_opts \
          "$TEST_USER@$TEST_HOST" $remote_cmd \
          >"$client_log" 2>&1
        echo "EXIT:$?" >> "$client_log"
      ) &
      client_pids+=($!)
    done

    launched=$batch_end
    sleep 0.3  # Small interval between batches
  done

  # All client child processes created, release barrier at once
  sleep 0.5
  rm -f "$barrier_file"
  echo "[$(date +%H:%M:%S)] Barrier released — all $target_n clients starting connections."

  # ---- Wait for connections to enter pending / auth pause state ----
  sleep 4
  echo "[$(date +%H:%M:%S)] Clients should be in pending/paused state now."

  # ---- Hold phase: sample memory and pending count ----
  local mem_samples_file="$WORK_DIR/mem_${mode}_p${target_n}_r${run_id}.csv"
  echo "timestamp_epoch,memory_bytes,memory_mb,pending_estimate,pids_current" > "$mem_samples_file"

  local max_mem_bytes=0
  local max_pending=0
  local max_pids=0

  local hold_start="$(date +%s)"
  while true; do
    local now_t="$(date +%s)"
    local elapsed=$((now_t - hold_start))
    if [[ $elapsed -ge $HOLD_WINDOW_SEC ]]; then
      break
    fi

    local mem_val pending_est pids_val
    mem_val="$(read_memory_current "$cg_path")"
    pending_est="$(get_pending_from_log "$sshd_log")"
    pids_val="$(read_pids_current "$cg_path")"

    echo "$(date +%s.%N),$mem_val,$(bytes_to_mb "$mem_val"),$pending_est,$pids_val" >> "$mem_samples_file"

    # Track peak values
    if [[ "$mem_val" != "NA" && "$mem_val" =~ ^[0-9]+$ ]] && [[ "$mem_val" -gt "$max_mem_bytes" ]]; then
      max_mem_bytes="$mem_val"
    fi
    if [[ "$pending_est" =~ ^[0-9]+$ ]] && [[ "$pending_est" -gt "$max_pending" ]]; then
      max_pending="$pending_est"
    fi
    if [[ "$pids_val" != "NA" && "$pids_val" =~ ^[0-9]+$ ]] && [[ "$pids_val" -gt "$max_pids" ]]; then
      max_pids="$pids_val"
    fi

    sleep "$SAMPLE_INTERVAL_SEC"
  done

  # Cross-validate with memory.peak
  local peak_mem
  peak_mem="$(read_memory_peak "$cg_path")"
  if [[ "$peak_mem" != "NA" && "$peak_mem" =~ ^[0-9]+$ ]]; then
    max_mem_bytes="$peak_mem"
  fi

  local peak_mem_mb
  peak_mem_mb="$(bytes_to_mb "$max_mem_bytes")"

  echo "[$(date +%H:%M:%S)] Hold phase done. peak_mem=${peak_mem_mb} MB, pending≈${max_pending} (from_samples), pids≈${max_pids}"

  # ---- Wait for all clients to finish or timeout ----
  echo "[$(date +%H:%M:%S)] Waiting for clients to finish..."

  local client_timeout=$((CLIENT_CONNECT_TIMEOUT + 5))
  for pid in "${client_pids[@]}"; do
    if kill -0 "$pid" 2>/dev/null; then
      (
        sleep "$client_timeout"
        kill "$pid" 2>/dev/null || true
      ) &
    fi
    wait "$pid" 2>/dev/null || true
  done

  echo "[$(date +%H:%M:%S)] All clients finished."

  # ---- Baseline: count actual concurrent pause peak from client logs ----
  if [[ "$mode" == "baseline" ]]; then
    local baseline_peak
    baseline_peak="$(get_baseline_peak_from_client_logs "$client_logs_dir")"
    echo "[$(date +%H:%M:%S)] Baseline peak paused (from client logs): ${baseline_peak}"
    if [[ "$baseline_peak" =~ ^[0-9]+$ ]] && [[ "$baseline_peak" -gt "$max_pending" ]]; then
      max_pending="$baseline_peak"
    fi
  fi

  # ---- Observe residual memory after disconnect ----
  sleep "$POST_HOLD_WAIT_SEC"
  local residual_mem residual_mem_mb
  residual_mem="$(read_memory_current "$cg_path")"
  residual_mem_mb="$(bytes_to_mb "$residual_mem")"

  # ---- Check whether pending has cleared to zero ----
  local final_pending
  final_pending="$(get_pending_from_log "$sshd_log")"
  local cleanup_ok="YES"
  if [[ "$final_pending" =~ ^[0-9]+$ ]] && [[ "$final_pending" -gt 0 ]]; then
    cleanup_ok="NO($final_pending)"
  fi

  echo "[$(date +%H:%M:%S)] Post-hold: residual_mem=${residual_mem_mb} MB, pending_remain=${final_pending}, cleanup=${cleanup_ok}"

  # ---- Cleanup ----
  kill "$sshd_pid" 2>/dev/null || true
  wait "$sshd_pid" 2>/dev/null || true

  # ---- sshd has exited, log fully flushed, compute peak pending ----
  local log_peak_pending
  log_peak_pending="$(get_peak_pending_from_log "$sshd_log")"
  if [[ "$log_peak_pending" =~ ^[0-9]+$ ]] && [[ "$log_peak_pending" -gt "$max_pending" ]]; then
    max_pending="$log_peak_pending"
  fi
  echo "[$(date +%H:%M:%S)] Log-based peak pending: ${log_peak_pending} (log=${sshd_log})"

  # ---- Write results after the sshd log is fully flushed ----
  echo "${target_n},${mode},${run_id},${max_mem_bytes},${peak_mem_mb},${mem_samples_file},${max_pending},${max_pids},${residual_mem_mb},${final_pending},${cleanup_ok}" >> "$SUMMARY_CSV"

  sleep 1
  destroy_cgroup "$cg_path"

  # Cooldown
  sleep 5
}

# ---- State cleanup dedicated tests (small scale) ----
# Note: cleanup tests don't need cgroup (not measuring memory), only verify pending counter goes to zero
# sshd runs in foreground with -D, -E writes log for get_pending_from_log to read
run_cleanup_tests() {
  echo ""
  echo "=== Cleanup Tests ==="

  local test_label cleanup_log spid remaining

  # Test 1: normal completion
  test_label="normal_complete"
  echo "[$(date +%H:%M:%S)] Cleanup test: $test_label"

  cleanup_log="$WORK_DIR/cleanup_${test_label}.log"
  : > "$cleanup_log"

  "$SSHD_BIN" -D -f "$SSHD_CFG_KEM" -E "$cleanup_log" &
  spid=$!
  sleep 1

  export KEMUAUTH_RESPONSE_DELAY_MS="2000"
  # shellcheck disable=SC2086
  timeout 15 "$SSH_BIN" $KEM_CLIENT_OPTS "$TEST_USER@$TEST_HOST" true >/dev/null 2>&1 || true
  sleep 3

  remaining="$(get_pending_from_log "$cleanup_log")"
  echo "  -> $test_label: remaining_pending=$remaining $(if [[ "$remaining" -eq 0 ]]; then echo 'OK'; else echo 'FAIL'; fi)"

  kill "$spid" 2>/dev/null || true; wait "$spid" 2>/dev/null || true
  sleep 2

  # Test 2: client disconnects early
  test_label="client_disconnect"
  echo "[$(date +%H:%M:%S)] Cleanup test: $test_label"

  cleanup_log="$WORK_DIR/cleanup_${test_label}.log"
  : > "$cleanup_log"

  "$SSHD_BIN" -D -f "$SSHD_CFG_KEM" -E "$cleanup_log" &
  spid=$!
  sleep 1

  export KEMUAUTH_RESPONSE_DELAY_MS="5000"
  # shellcheck disable=SC2086
  timeout 3 "$SSH_BIN" $KEM_CLIENT_OPTS "$TEST_USER@$TEST_HOST" true >/dev/null 2>&1 || true
  sleep 3

  remaining="$(get_pending_from_log "$cleanup_log")"
  echo "  -> $test_label: remaining_pending=$remaining $(if [[ "$remaining" -eq 0 ]]; then echo 'OK'; else echo 'FAIL'; fi)"

  kill "$spid" 2>/dev/null || true; wait "$spid" 2>/dev/null || true
  sleep 2

  # Test 3: client sends incorrect response
  test_label="error_response"
  echo "[$(date +%H:%M:%S)] Cleanup test: $test_label"

  cleanup_log="$WORK_DIR/cleanup_${test_label}.log"
  : > "$cleanup_log"

  "$SSHD_BIN" -D -f "$SSHD_CFG_KEM" -E "$cleanup_log" &
  spid=$!
  sleep 1

  # Construct a KEM identity with the authorized public key but an
  # unrelated secret key, so the request is authorized while the client
  # derives an incorrect response.
  export KEMUAUTH_RESPONSE_DELAY_MS="2000"
  local wrong_kem_file="$WORK_DIR/wrong_kem_id"
  local alternate_kem_file="$WORK_DIR/alternate_kem_id"

  rm -f "$alternate_kem_file" "$wrong_kem_file"

  if ! bash "$BACKENDS_DIR/generate_kem_identity.sh"       "$alternate_kem_file" "ML-KEM-768" >/dev/null; then
    echo "[ERR] failed to generate alternate KEM identity for cleanup test"
    return 1
  fi

  local wrong_secret_b64
  wrong_secret_b64="$(awk 'BEGIN{IGNORECASE=1} $1~/^secret$/{print $2; exit}'       "$alternate_kem_file")"

  if [[ -z "$wrong_secret_b64" ]]; then
    echo "[ERR] alternate KEM secret key is missing"
    return 1
  fi

  cat > "$wrong_kem_file" <<EOF
algorithm ML-KEM-768
public $KEM_PUBLIC_B64
secret $wrong_secret_b64
EOF

  local wrong_client_opts
  wrong_client_opts="$(build_client_opts       "$KNOWN_HOSTS" "$ID_ED25519" "$wrong_kem_file" "yes" "ML-KEM-768")"

  # shellcheck disable=SC2086
  timeout 15 "$SSH_BIN" $wrong_client_opts       "$TEST_USER@$TEST_HOST" true >/dev/null 2>&1 || true
  sleep 3

  remaining="$(get_pending_from_log "$cleanup_log")"
  echo "  -> $test_label: remaining_pending=$remaining $(if [[ "$remaining" -eq 0 ]]; then echo 'OK'; else echo 'FAIL'; fi)"

  kill "$spid" 2>/dev/null || true; wait "$spid" 2>/dev/null || true
  sleep 2

  echo "=== Cleanup tests done ==="
}

# ---- Main loop ----
echo ""
echo "================================================"
echo "  Pending Authentication State Memory"
echo "  Target P: $TARGET_CONCURRENCY"
echo "  Delay: ${RESPONSE_DELAY_MS}ms  Hold: ${HOLD_WINDOW_SEC}s"
echo "  Runs: $RUNS"
echo "================================================"
echo ""

for P in $TARGET_CONCURRENCY; do
  for ((r=1; r<=RUNS; r++)); do
    # KEMUAuth
    run_one_round "kem" "$P" "$r" || echo "[WARN] kem P=$P r=$r had issues"

    # Baseline (ML-DSA-65)
    if [[ "$P" -gt 0 ]]; then
      run_one_round "baseline" "$P" "$r" || echo "[WARN] baseline P=$P r=$r had issues"
    fi
  done
done

# ---- Cleanup tests ----
if [[ "${SKIP_CLEANUP_TESTS:-0}" != "1" ]]; then
  run_cleanup_tests
else
  echo "[INFO] Skipping cleanup tests (SKIP_CLEANUP_TESTS=1)"
fi

echo ""
echo "================================================"
echo "  Pending-memory experiment complete!"
echo "  Summary: $SUMMARY_CSV"
echo "================================================"

# ---- Analysis ----
if command -v python3 >/dev/null 2>&1; then
  if ! python3 "$SCRIPT_DIR/analyze.py" \
    "$SUMMARY_CSV" \
    "$RESULT_DIR/report.md"; then
    echo "[ERR] pending-memory result analysis failed"
    exit 1
  fi

  if [[ -f "$RESULT_DIR/report.md" ]]; then
    echo ""
    echo "=== Report ==="
    cat "$RESULT_DIR/report.md"
  fi
fi
