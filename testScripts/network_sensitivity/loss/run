#!/usr/bin/env bash
# Packet-loss sensitivity experiment for the extended KEMUAuth evaluation
#
# Fixed RTT=67ms, comparing KEMUAuth vs ML-DSA-65 under different packet loss rates.
#
# Usage:
#   sudo bash testScripts/network_sensitivity/loss/run

set -euo pipefail

ROOT_DIR="$(cd "$(dirname "$0")/../../.." && pwd)"
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
BACKENDS_DIR="$ROOT_DIR/testScripts/backends"

# ---- Must be set before sourcing sshd_test_harness.sh ----
TEST_PORT="${TEST_PORT:-42590}"

source "$BACKENDS_DIR/sshd_test_harness.sh"
source "$BACKENDS_DIR/netem_setup.sh"

# ---- Parameters ----
LOSS_LIST="${LOSS_LIST:-0 0.1 0.5 1.0 2.0}"
BASE_RTT="${BASE_RTT:-67}"
ITERATIONS_PER_REPETITION="${ITERATIONS_PER_REPETITION:-200}"
REPETITIONS="${REPETITIONS:-5}"
INITCWND_MSS="${INITCWND_MSS:-10}"
NETEM_IFACE="${NETEM_IFACE:-lo}"
# Under sudo $(id -un) returns root, but sshd has PermitRootLogin no
SUDO_USER="${SUDO_USER:-$USER}"
TEST_USER="${TEST_USER:-$SUDO_USER}"
TEST_HOST="${TEST_HOST:-127.0.0.1}"
KEEP_WORKDIR="${KEEP_WORKDIR:-1}"

WORK_DIR="${WORK_DIR:-$ROOT_DIR/testScripts/.work-network-loss}"
RESULT_DIR="$SCRIPT_DIR/results"

# ---- Root check ----
if [[ "$(id -u)" -ne 0 ]]; then
  echo "[ERR] packet-loss sensitivity experiment requires root for tc/netem"
  echo "[HINT] run: sudo $0"
  exit 1
fi

check_ssh_binaries || exit 1

# ---- Cleanup leftover processes ----
# Kill leftover sshd processes to free the port
pkill -f "sshd.*-f.*${WORK_DIR}" 2>/dev/null || true
# Cleanup leftover cgroups
find /sys/fs/cgroup -maxdepth 1 -name "ssh-*" -type d 2>/dev/null | while read d; do rmdir "$d" 2>/dev/null || true; done
sleep 1
check_netem_deps || exit 1

mkdir -p "$WORK_DIR" "$RESULT_DIR"

# ---- Authentication identities ----
# server hostkey: Ed25519 (consistent with paper Figure 4)
HOST_KEY_ED25519="$(gen_host_key_ed25519 "$WORK_DIR")"
ID_ED25519="$(gen_user_key_ed25519 "$WORK_DIR")"
ID_MD65="$(gen_user_key_mldsa65 "$WORK_DIR")"

KNOWN_HOSTS="$WORK_DIR/known_hosts"
gen_known_hosts "$WORK_DIR" "$HOST_KEY_ED25519.pub" >/dev/null

AUTHORIZED_KEYS="$WORK_DIR/authorized_keys"
cat "$ID_MD65.pub" > "$AUTHORIZED_KEYS"

KEM_ID_FILE="${KEM_ID_FILE:-$ROOT_DIR/testScripts/.work-kem/id_mlkem768}"
if [[ ! -f "$KEM_ID_FILE" ]]; then
  echo "[ERR] KEM identity not found: $KEM_ID_FILE"
  exit 1
fi
KEM_PUBLIC_B64="$(awk 'BEGIN{IGNORECASE=1} $1~/^public$/{print $2; exit}' "$KEM_ID_FILE")"
AUTHORIZED_KEM_KEYS="$WORK_DIR/authorized_kem_keys"
printf 'ML-KEM-768 %s\n' "$KEM_PUBLIC_B64" > "$AUTHORIZED_KEM_KEYS"

# ---- sshd configuration ----
SSHD_CFG="$WORK_DIR/sshd.conf"
SSHD_LOG="$WORK_DIR/sshd.log"

cat > "$SSHD_CFG" <<EOF
Port $TEST_PORT
ListenAddress $TEST_HOST
PidFile $WORK_DIR/sshd.pid
HostKey $HOST_KEY_ED25519
HostKeyAlgorithms ssh-ed25519
KexAlgorithms mlkem768x25519-sha256
LogLevel ERROR
SshdSessionPath $SSHD_SESSION_BIN
SshdAuthPath $SSHD_AUTH_BIN

PasswordAuthentication no
KbdInteractiveAuthentication no
ChallengeResponseAuthentication no
PermitRootLogin no

PubkeyAuthentication yes
PubkeyAcceptedAlgorithms ssh-ed25519,ssh-mldsa-65
AuthorizedKeysFile $AUTHORIZED_KEYS
KEMAuthentication yes
KEMAuthAlgorithms ML-KEM-768
AuthorizedKEMKeysFile $AUTHORIZED_KEM_KEYS

MaxStartups 256
MaxSessions 1
LoginGraceTime 120
StrictModes no
X11Forwarding no
AllowAgentForwarding no
AllowTcpForwarding no
PrintMotd no
EOF

# ---- Client opts ----
# Explicitly pin transport and authentication algorithms for reproducibility
KEM_CLIENT_OPTS="-o StrictHostKeyChecking=no -o UserKnownHostsFile=$KNOWN_HOSTS -o BatchMode=yes -o PasswordAuthentication=no -o KbdInteractiveAuthentication=no -o ConnectTimeout=60 -o ControlMaster=no -o ControlPersist=no -o KexAlgorithms=mlkem768x25519-sha256 -o HostKeyAlgorithms=ssh-ed25519 -o PreferredAuthentications=publickey-kem -o PubkeyAuthentication=no -o KEMAuthentication=yes -o KEMAuthAlgorithms=ML-KEM-768 -o IdentityKEMFile=$KEM_ID_FILE -o LogLevel=ERROR -p $TEST_PORT"

SIG_CLIENT_OPTS="-o StrictHostKeyChecking=no -o UserKnownHostsFile=$KNOWN_HOSTS -o BatchMode=yes -o PasswordAuthentication=no -o KbdInteractiveAuthentication=no -o ConnectTimeout=60 -o ControlMaster=no -o ControlPersist=no -o KexAlgorithms=mlkem768x25519-sha256 -o HostKeyAlgorithms=ssh-ed25519 -o PreferredAuthentications=publickey -o PubkeyAcceptedAlgorithms=ssh-mldsa-65 -o IdentityFile=$ID_MD65 -o KEMAuthentication=no -o LogLevel=ERROR -p $TEST_PORT"

# ---- Results files ----
RAW_CSV="$RESULT_DIR/loss_raw.csv"
SUMMARY_CSV="$RESULT_DIR/loss_summary.csv"
RETRANS_CSV="$RESULT_DIR/loss_retrans.csv"   # Batch-level TCP retransmission statistics

echo "loss_pct,repetition,mode,iteration,latency_ms,success,retcode,tcp_retrans_delta" > "$RAW_CSV"
echo "loss_pct,mode,total,successes,failures,failure_rate_pct,p50_ms,p95_ms,p99_ms,mean_ms,avg_tcp_retrans_per_conn" > "$SUMMARY_CSV"
echo "loss_pct,repetition,mode,total_conns,tcp_retrans_delta" > "$RETRANS_CSV"

# ---- Single connection ----
single_connect() {
  local opts="$1"
  local retcode=0
  local start_ep end_ep lat_ms

  start_ep="$(date +%s.%N)"
  # shellcheck disable=SC2086
  "$SSH_BIN" $opts "$TEST_USER@$TEST_HOST" true >/dev/null 2>&1 || retcode=$?
  end_ep="$(date +%s.%N)"

  lat_ms="$(python3 -c "
s=float('$start_ep')
e=float('$end_ep')
print(f'{(e-s)*1000:.2f}')
" 2>/dev/null || echo "NA")"

  echo "$lat_ms $retcode"
}

# ---- Main loop ----
echo ""
echo "================================================"
echo "  Packet-Loss Sensitivity"
echo "  Base RTT: ${BASE_RTT} ms"
echo "  Loss rates: $LOSS_LIST %"
echo "  Repetitions: $REPETITIONS"
echo "  Connections per repetition and method: $ITERATIONS_PER_REPETITION"
echo "================================================"
echo ""

# Set base RTT + cwnd
set_netem_delay "$NETEM_IFACE" "$BASE_RTT"
# Disable TSO/GSO/GRO to avoid packet coalescing affecting netem loss simulation
disable_offload "$NETEM_IFACE"
if [[ "$INITCWND_MSS" -gt 0 ]]; then
  "$SUDO_BIN" ip route replace "$TEST_HOST" dev "$NETEM_IFACE" initcwnd "$INITCWND_MSS" 2>/dev/null || true
fi

# Start sshd
"$SSHD_BIN" -D -f "$SSHD_CFG" -E "$SSHD_LOG" &
SSHD_PID=$!
sleep 1

cleanup_all() {
  if [[ -n "${SSHD_PID:-}" ]] && kill -0 "$SSHD_PID" 2>/dev/null; then
    kill "$SSHD_PID" 2>/dev/null || true
    wait "$SSHD_PID" 2>/dev/null || true
  fi
  clear_netem "$NETEM_IFACE"
}
trap cleanup_all EXIT

echo "[INFO] sshd PID=$SSHD_PID"

for LOSS in $LOSS_LIST; do
  for ((rep_idx=1; rep_idx<=REPETITIONS; rep_idx++)); do

    # Set loss
    if [[ "$LOSS" == "0" ]]; then
      # Reset to pure delay
      set_netem_delay "$NETEM_IFACE" "$BASE_RTT"
    else
      set_netem_delay_loss "$NETEM_IFACE" "$BASE_RTT" "$LOSS"
    fi

    sleep 1

    echo ""
    echo "────────────────────────────────────"
    echo "  Loss=${LOSS}%  repetition=${rep_idx}/${REPETITIONS}"
    echo "────────────────────────────────────"

    # Read initial TCP retransmission
    tcp_retrans_start="$(read_tcp_retrans)"

    # KEMUAuth
    echo "[$(date +%H:%M:%S)] KEMUAuth ..."
    kem_conns=0
    for ((i=0; i<ITERATIONS_PER_REPETITION; i++)); do
      result="$(single_connect "$KEM_CLIENT_OPTS")"
      lat_ms="${result%% *}"
      retcode="${result##* }"
      success=0
      [[ "$retcode" -eq 0 ]] && success=1
      echo "${LOSS},${rep_idx},kem,${i},${lat_ms},${success},${retcode},NA" >> "$RAW_CSV"
      kem_conns=$((kem_conns + 1))
    done

    # Read KEM batch TCP retransmission
    tcp_retrans_kem="$(read_tcp_retrans)"
    if [[ "$tcp_retrans_start" != "NA" && "$tcp_retrans_kem" != "NA" ]] && \
       [[ "$tcp_retrans_start" =~ ^[0-9]+$ ]] && [[ "$tcp_retrans_kem" =~ ^[0-9]+$ ]]; then
      tcp_retrans_delta_kem=$((tcp_retrans_kem - tcp_retrans_start))
    else
      tcp_retrans_delta_kem="NA"
    fi
    echo "${LOSS},${rep_idx},kem,${kem_conns},${tcp_retrans_delta_kem}" >> "$RETRANS_CSV"

    # ML-DSA-65
    echo "[$(date +%H:%M:%S)] ML-DSA-65 ..."
    tcp_retrans_mid="$(read_tcp_retrans)"
    mldsa_conns=0
    for ((i=0; i<ITERATIONS_PER_REPETITION; i++)); do
      result="$(single_connect "$SIG_CLIENT_OPTS")"
      lat_ms="${result%% *}"
      retcode="${result##* }"
      success=0
      [[ "$retcode" -eq 0 ]] && success=1
      echo "${LOSS},${rep_idx},mldsa,${i},${lat_ms},${success},${retcode},NA" >> "$RAW_CSV"
      mldsa_conns=$((mldsa_conns + 1))
    done

    # Read ML-DSA batch TCP retransmission
    tcp_retrans_end="$(read_tcp_retrans)"
    if [[ "$tcp_retrans_mid" != "NA" && "$tcp_retrans_end" != "NA" ]] && \
       [[ "$tcp_retrans_mid" =~ ^[0-9]+$ ]] && [[ "$tcp_retrans_end" =~ ^[0-9]+$ ]]; then
      tcp_retrans_delta_mldsa=$((tcp_retrans_end - tcp_retrans_mid))
    else
      tcp_retrans_delta_mldsa="NA"
    fi
    echo "${LOSS},${rep_idx},mldsa,${mldsa_conns},${tcp_retrans_delta_mldsa}" >> "$RETRANS_CSV"

    echo "[INFO] TCP retrans delta: KEM=${tcp_retrans_delta_kem} (${kem_conns} conns), MLDSA=${tcp_retrans_delta_mldsa} (${mldsa_conns} conns)"
  done
done

echo ""
echo "================================================"
echo "[OK] packet-loss sensitivity experiment complete"
echo "================================================"

# Analysis
LOSS_REPORT="$RESULT_DIR/loss_report.md"

if ! python3 "$SCRIPT_DIR/analyze.py" \
  "$RAW_CSV" \
  "$SUMMARY_CSV" \
  "$RETRANS_CSV" \
  "$LOSS_REPORT"; then
  echo "[ERR] packet-loss result analysis failed"
  exit 1
fi

if [[ -f "$LOSS_REPORT" ]]; then
  cat "$LOSS_REPORT"
fi
