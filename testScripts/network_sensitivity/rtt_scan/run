#!/usr/bin/env bash
# RTT sensitivity experiment for the extended KEMUAuth evaluation
#
# Compare KEMUAuth vs ML-DSA-65 across 9 RTT points from 0~200ms,
# measuring full SSH connection latency p50/p95.
#
# Usage:
#   sudo bash testScripts/network_sensitivity/rtt_scan/run

set -euo pipefail

ROOT_DIR="$(cd "$(dirname "$0")/../../.." && pwd)"
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
BACKENDS_DIR="$ROOT_DIR/testScripts/backends"

# ---- Must be set before sourcing sshd_test_harness.sh ----
TEST_PORT="${TEST_PORT:-42580}"

source "$BACKENDS_DIR/sshd_test_harness.sh"
source "$BACKENDS_DIR/netem_setup.sh"

# ---- Parameters ----
RTT_LIST="${RTT_LIST:-0 20 40 60 80 100 120 160 200}"
ITERATIONS="${ITERATIONS:-500}"       # Connections per RTT point per scheme
INITCWND_MSS="${INITCWND_MSS:-10}"    # TCP initial congestion window
NETEM_IFACE="${NETEM_IFACE:-lo}"      # Interface for netem to operate on
# Under sudo $(id -un) returns root, but sshd has PermitRootLogin no
SUDO_USER="${SUDO_USER:-$USER}"
TEST_USER="${TEST_USER:-$SUDO_USER}"
TEST_HOST="${TEST_HOST:-127.0.0.1}"
KEEP_WORKDIR="${KEEP_WORKDIR:-1}"
SUDO_BIN="${SUDO_BIN:-sudo}"

WORK_DIR="${WORK_DIR:-$ROOT_DIR/testScripts/.work-network-rtt}"
RESULT_DIR="$SCRIPT_DIR/results"

# ---- Root check (required for netem) ----
if [[ "$(id -u)" -ne 0 ]]; then
  echo "[ERR] RTT sensitivity experiment requires root for tc/netem"
  echo "[HINT] run: sudo $0"
  exit 1
fi

check_ssh_binaries || exit 1

# ---- Cleanup leftover processes ----
# Kill leftover sshd processes to free the port
pkill -f "sshd.*-f.*${WORK_DIR}" 2>/dev/null || true
# Cleanup leftover cgroups
find /sys/fs/cgroup -maxdepth 1 -name "ssh-*" -type d 2>/dev/null | while read d; do rmdir "$d" 2>/dev/null || true; done
sleep 1
check_netem_deps || exit 1

mkdir -p "$WORK_DIR" "$RESULT_DIR"

# ---- Keys ----
# server hostkey: Ed25519 (consistent with paper Figure 4)
HOST_KEY_ED25519="$(gen_host_key_ed25519 "$WORK_DIR")"
ID_ED25519="$(gen_user_key_ed25519 "$WORK_DIR")"
ID_MD65="$(gen_user_key_mldsa65 "$WORK_DIR")"

KNOWN_HOSTS="$WORK_DIR/known_hosts"
gen_known_hosts "$WORK_DIR" "$HOST_KEY_ED25519.pub" >/dev/null

AUTHORIZED_KEYS="$WORK_DIR/authorized_keys"
cat "$ID_MD65.pub" > "$AUTHORIZED_KEYS"

KEM_ID_FILE="${KEM_ID_FILE:-$ROOT_DIR/testScripts/.work-kem/id_mlkem768}"
if [[ ! -f "$KEM_ID_FILE" ]]; then
  echo "[ERR] KEM identity not found"
  exit 1
fi
KEM_PUBLIC_B64="$(awk 'BEGIN{IGNORECASE=1} $1~/^public$/{print $2; exit}' "$KEM_ID_FILE")"
AUTHORIZED_KEM_KEYS="$WORK_DIR/authorized_kem_keys"
printf 'ML-KEM-768 %s\n' "$KEM_PUBLIC_B64" > "$AUTHORIZED_KEM_KEYS"

# ---- sshd configuration ----
SSHD_CFG="$WORK_DIR/sshd.conf"
SSHD_LOG="$WORK_DIR/sshd.log"

# Common sshd config (both auth types allowed, switched via client opts)
cat > "$SSHD_CFG" <<EOF
Port $TEST_PORT
ListenAddress $TEST_HOST
PidFile $WORK_DIR/sshd.pid
HostKey $HOST_KEY_ED25519
HostKeyAlgorithms ssh-ed25519
KexAlgorithms mlkem768x25519-sha256
LogLevel ERROR
SshdSessionPath $SSHD_SESSION_BIN
SshdAuthPath $SSHD_AUTH_BIN

PasswordAuthentication no
KbdInteractiveAuthentication no
ChallengeResponseAuthentication no
PermitRootLogin no

PubkeyAuthentication yes
PubkeyAcceptedAlgorithms ssh-ed25519,ssh-mldsa-65
AuthorizedKeysFile $AUTHORIZED_KEYS
KEMAuthentication yes
KEMAuthAlgorithms ML-KEM-768
AuthorizedKEMKeysFile $AUTHORIZED_KEM_KEYS

MaxStartups 256
MaxSessions 1
LoginGraceTime 120
StrictModes no
X11Forwarding no
AllowAgentForwarding no
AllowTcpForwarding no
PrintMotd no
EOF

# ---- Client opts ----
# Explicitly pin transport and authentication algorithms for reproducibility
KEM_CLIENT_OPTS="-o StrictHostKeyChecking=no -o UserKnownHostsFile=$KNOWN_HOSTS -o BatchMode=yes -o PasswordAuthentication=no -o KbdInteractiveAuthentication=no -o ConnectTimeout=30 -o ControlMaster=no -o ControlPersist=no -o KexAlgorithms=mlkem768x25519-sha256 -o HostKeyAlgorithms=ssh-ed25519 -o PreferredAuthentications=publickey-kem -o PubkeyAuthentication=no -o KEMAuthentication=yes -o KEMAuthAlgorithms=ML-KEM-768 -o IdentityKEMFile=$KEM_ID_FILE -o LogLevel=ERROR -p $TEST_PORT"

SIG_CLIENT_OPTS="-o StrictHostKeyChecking=no -o UserKnownHostsFile=$KNOWN_HOSTS -o BatchMode=yes -o PasswordAuthentication=no -o KbdInteractiveAuthentication=no -o ConnectTimeout=30 -o ControlMaster=no -o ControlPersist=no -o KexAlgorithms=mlkem768x25519-sha256 -o HostKeyAlgorithms=ssh-ed25519 -o PreferredAuthentications=publickey -o PubkeyAcceptedAlgorithms=ssh-mldsa-65 -o IdentityFile=$ID_MD65 -o KEMAuthentication=no -o LogLevel=ERROR -p $TEST_PORT"

# ---- Results files ----
RAW_CSV="$RESULT_DIR/rtt_raw.csv"
SUMMARY_CSV="$RESULT_DIR/rtt_summary.csv"

echo "rtt_ms,mode,iteration,latency_ms,success,retcode,ping_rtt_ms" > "$RAW_CSV"
echo "rtt_ms,mode,total,successes,failures,failure_rate_pct,p50_ms,p95_ms,mean_ms,ping_rtt_median_ms" > "$SUMMARY_CSV"

# ---- Single connection ----
single_connect() {
  local opts="$1"
  local retcode=0
  local start_ep end_ep lat_ms

  start_ep="$(date +%s.%N)"

  # shellcheck disable=SC2086
  "$SSH_BIN" $opts "$TEST_USER@$TEST_HOST" true >/dev/null 2>&1 || retcode=$?

  end_ep="$(date +%s.%N)"
  lat_ms="$(python3 -c "
s=float('$start_ep')
e=float('$end_ep')
print(f'{(e-s)*1000:.2f}')
" 2>/dev/null || echo "NA")"

  echo "$lat_ms $retcode"
}

# ---- Verify RTT ----
measure_ping_rtt() {
  local target="$1"
  ping -c 5 -q "$target" 2>/dev/null | awk -F'/' 'END{print $5}' || echo "NA"
}

# ---- Main loop ----
echo ""
echo "================================================"
echo "  RTT Sensitivity Scan"
echo "  RTT: $RTT_LIST ms"
echo "  Iterations per point: $ITERATIONS"
echo "================================================"
echo ""

# Start sshd (persistent run)
"$SSHD_BIN" -D -f "$SSHD_CFG" -E "$SSHD_LOG" &
SSHD_PID=$!
sleep 1
echo "[INFO] sshd PID=$SSHD_PID"

# Disable TSO/GSO/GRO to avoid packet coalescing affecting netem delay simulation
disable_offload "$NETEM_IFACE"

cleanup_sshd() {
  if [[ -n "${SSHD_PID:-}" ]] && kill -0 "$SSHD_PID" 2>/dev/null; then
    kill "$SSHD_PID" 2>/dev/null || true
    wait "$SSHD_PID" 2>/dev/null || true
  fi
  clear_netem "$NETEM_IFACE"
}
trap cleanup_sshd EXIT

# Set initial cwnd (via ip route)
if [[ "$INITCWND_MSS" -gt 0 ]]; then
  "$SUDO_BIN" ip route replace "$TEST_HOST" dev "$NETEM_IFACE" initcwnd "$INITCWND_MSS" 2>/dev/null || true
fi

for RTT in $RTT_LIST; do
  echo ""
  echo "────────────────────────────────────"
  echo "  RTT = ${RTT}ms"
  echo "────────────────────────────────────"

  # Set netem
  if [[ "$RTT" -eq 0 ]]; then
    clear_netem "$NETEM_IFACE"
    echo "[INFO] netem cleared (RTT=0)"
  else
    set_netem_delay "$NETEM_IFACE" "$RTT"
  fi

  sleep 1

  # Measure actual RTT
  actual_rtt="$(measure_ping_rtt "$TEST_HOST")"
  echo "[INFO] ping RTT: ${actual_rtt}ms"

  # KEMUAuth
  echo "[$(date +%H:%M:%S)] KEMUAuth ..."
  for ((i=0; i<ITERATIONS; i++)); do
    result="$(single_connect "$KEM_CLIENT_OPTS")"
    lat_ms="${result%% *}"
    retcode="${result##* }"
    success=0
    [[ "$retcode" -eq 0 ]] && success=1
    echo "${RTT},kem,${i},${lat_ms},${success},${retcode},${actual_rtt}" >> "$RAW_CSV"

    if (( (i+1) % 100 == 0 )); then
      echo "  KEMUAuth: $((i+1))/$ITERATIONS"
    fi
  done

  # ML-DSA-65
  echo "[$(date +%H:%M:%S)] ML-DSA-65 ..."
  for ((i=0; i<ITERATIONS; i++)); do
    result="$(single_connect "$SIG_CLIENT_OPTS")"
    lat_ms="${result%% *}"
    retcode="${result##* }"
    success=0
    [[ "$retcode" -eq 0 ]] && success=1
    echo "${RTT},mldsa,${i},${lat_ms},${success},${retcode},${actual_rtt}" >> "$RAW_CSV"

    if (( (i+1) % 100 == 0 )); then
      echo "  ML-DSA-65: $((i+1))/$ITERATIONS"
    fi
  done
done

# Cleanup netem
clear_netem "$NETEM_IFACE"

echo ""
echo "================================================"
echo "[OK] RTT sensitivity scan complete"
echo "================================================"

# Generate summary
RTT_REPORT="$RESULT_DIR/rtt_report.md"

if ! python3 "$SCRIPT_DIR/analyze.py" \
  "$RAW_CSV" \
  "$SUMMARY_CSV" \
  "$RTT_REPORT"; then
  echo "[ERR] RTT result analysis failed"
  exit 1
fi

if [[ -f "$RTT_REPORT" ]]; then
  cat "$RTT_REPORT"
fi
